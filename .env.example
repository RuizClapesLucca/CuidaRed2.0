# Copia este archivo como .env solo para pruebas locales. En Render, estas mismas
# variables se configuran en Environment. NUNCA subas el .env real a GitHub.

# Cadena de conexión de Supabase (Connect > Session pooler, puerto 5432).
DATABASE_URL=postgresql://postgres.TU_REFERENCIA:TU_CONTRASENA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PHONE_HMAC_SECRET=

# Exactamente 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
PHONE_ENCRYPTION_KEY=
